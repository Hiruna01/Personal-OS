NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-or-hosted-publishable-key
APP_URL=http://localhost:3000
# Used ONLY by the explicit provisioning script; never by owner requests.
SUPABASE_SECRET_KEY=your-admin-secret-key
OWNER_EMAIL=you@example.com
# At least 12 characters. Used only for initial account creation.
OWNER_PASSWORD=replace-with-a-long-unique-password
WORKSPACE_NAME=My workspace
# Read-only synthetic UI. Forced off in production, regardless of this value.
ENABLE_DEMO=true
